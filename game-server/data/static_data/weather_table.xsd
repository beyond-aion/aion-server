<?xml version="1.0" encoding="utf-8"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="weather">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded" name="map" type="WeatherTable" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="WeatherTable">
		<xs:sequence>
			<xs:element minOccurs="0" maxOccurs="unbounded" name="weather" type="WeatherEntry" />
		</xs:sequence>
		<xs:attribute name="zone_count" type="xs:int" use="required" />
		<xs:attribute name="id" type="xs:int" use="required" />
	</xs:complexType>
	<xs:complexType name="WeatherEntry">
		<xs:sequence>
			<xs:element minOccurs="0" name="sign" type="WeatherPhase" />
			<xs:element minOccurs="0" name="remain" type="WeatherPhase" />
			<xs:element minOccurs="0" maxOccurs="4" name="sub" type="WeatherPhase" />
		</xs:sequence>
		<xs:attribute name="code" type="xs:int" use="required" />
		<xs:attribute name="name" type="xs:string" use="required" />
		<xs:attribute name="zone" type="xs:int" use="required" />
		<xs:attribute name="priority" type="xs:int" use="required" />
		<xs:attribute name="months" type="xs:string" />
		<xs:attribute name="hours" type="xs:string" />
		<xs:attribute name="occur_prob" type="xs:int" use="required" />
		<xs:attribute name="occur_delay" type="xs:int" />
		<xs:attribute name="duration" type="xs:int" use="required" />
		<xs:attribute name="duration_ex" type="xs:int" />
		<xs:attribute name="attribute" type="WeatherAttribute" />
		<xs:attribute name="att_ranking" type="xs:int" />
		<xs:attribute name="state" type="WeatherState" />
	</xs:complexType>
	<xs:complexType name="WeatherPhase">
		<xs:attribute name="name" type="xs:string" use="required" />
		<xs:attribute name="probability" type="xs:int" />
		<xs:attribute name="duration" type="xs:int" />
		<xs:attribute name="duration_ex" type="xs:int" />
	</xs:complexType>
	<xs:simpleType name="WeatherState">
		<xs:restriction base="xs:string">
			<xs:enumeration value="RAIN" />
			<xs:enumeration value="SNOW" />
			<xs:enumeration value="WIND" />
			<xs:enumeration value="EARTHQUAKE" />
			<xs:enumeration value="HEATHAZE" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WeatherAttribute">
		<xs:restriction base="xs:string">
			<xs:enumeration value="water" />
			<xs:enumeration value="air" />
			<xs:enumeration value="earth" />
			<xs:enumeration value="fire" />
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
